{
  "name": "sobrew-wholesale-ordering-portal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "ws": "8.21.0",
    "postcss": "$postcss"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "db:types": "node scripts/generate-database-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "auth:jwks:check": "node scripts/sync-supabase-jwks.mjs",
    "auth:jwks:update": "node scripts/sync-supabase-jwks.mjs --write",
    "backfill:cogs": "node scripts/backfill-historical-cogs.mjs",
    "cron:recurring": "node scripts/run-recurring-cron.mjs",
    "repair:shipped-short-inventory": "node scripts/repair-shipped-short-inventory.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.114.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.7.5",
    "@vercel/speed-insights": "2.0.0",
    "lucide-react": "0.468.0",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^4.6.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "4.1.10"
  }
}
