  "changes": [
    "Recent Order GPM selects at most ten eligible rows from each shipment-date and legacy creation-date stream, merges by effective date/ID, then loads every item for the final ten orders.",
    "Positive-quantity/product eligibility and permission/center filters are applied before selecting the recent orders. Full sibling items remain available for financial allocations.",
    "Recent-order production history is fetched only for products with positive-quantity lines lacking a saved COGS snapshot. All historical runs for those products remain eligible for the existing fallback logic.",
    "The sales-rep settings/profile waterfall is replaced with one authenticated joined query, fully paginated to empty. Unfiltered reports load it concurrently with main report data.",
    "Requested sales-rep filters are validated before scoped report loading. Unfiltered AI reports and Payroll Labor GPM skip unused dropdown data; AI navigation retains validated existing filters.",
    "Independent 200-ID batches run with default concurrency three, configurable one to four. Pages within each batch remain sequential and advance by actual returned row count until empty.",
    "Inventory Adjustments skips standalone inventory valuation reads; its adjustment rows already embed the required item details."
  ],
  "preserved_invariants": [
    "Existing report permissions, RLS clients and center/sales-rep scopes.",
    "Historical production fallback semantics, including older viable runs behind voided or zero-cost runs.",
    "Complete sibling lines for shipping and fee allocations, including product-filtered reports.",
    "Sales lifetime/unshipped metrics and previous/trailing comparison periods.",
    "No short-page termination assumption; partial results are discarded after any read failure."
  ],
  "measurement_method": {
    "sample_count": 25,
    "per_page": "One full reload, one initial link navigation, three repeated link navigations.",
    "sequence": "Overview reload; Centers switch/reload; Recent Order GPM switch/reload; Dashboard switch/reload; Orders switch/reload; Overview switch; three Centers → Recent Order GPM → Dashboard → Orders → Overview cycles.",
    "metric": "Existing browser timing marker, performance.now from navigation/captured click to marker useEffect. Waited for the page-specific heading, Orders search box, and populated timing attribute.",
    "account": "Authenticated owner",
    "report_filters": "All products/customers/reps; October 1–31, 2026.",
    "preflight": "Warmup navigations and five captures without valid timing markers were excluded. All 25 saved samples have valid browser timings. No complete slow sample was discarded.",
    "limitations": [
      "Three repeated samples per page; medians describe this diagnostic run, not a population percentile or load test.",
      "Baseline and improved run were approximately one hour apart against the same database. Network and authentication latency vary.",
      "The Overview reload regressed from 2911.1 to 3671.5 ms. It included 988 ms authentication and 2190.6 ms main data. This sample is retained; the exact cause of the spike was not isolated.",
      "Reloads reuse sessions/caches and are not guaranteed cold-cache or server-cold-start measurements.",
      "Selected phases and spans are saved; spans overlap phases and must not be added. The main_data phase excludes earlier authentication.",
      "Dashboard and Orders had no route-specific optimization in this phase. Their smaller timing changes may reflect ordinary variability.",
      "Production performance was not retested because the implementation was not deployed."
    ]
  },
